# Copy this file to .env and adjust values as needed.
# All settings are loaded exclusively through config.py — never hardcode these elsewhere.

# ---- Document ingestion ----
DOCUMENTS_DIR=documents               # Folder ingest.py scans for source PDF/DOCX/TXT files
CHUNK_SIZE=300                        # Number of words per text chunk
CHUNK_OVERLAP=50                      # Number of words shared between consecutive chunks

# ---- Embeddings ----
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2 # sentence-transformers model used to embed chunks and queries
EMBEDDING_DIM=384                     # Output vector dimension of the embedding model

# ---- OpenSearch (vector store) ----
OPENSEARCH_HOST=localhost             # OpenSearch hostname
OPENSEARCH_PORT=9200                  # OpenSearch REST port
OPENSEARCH_INDEX_NAME=rag_documents   # Index name used to store chunk vectors + metadata
OPENSEARCH_USE_SSL=false              # Whether to connect to OpenSearch over HTTPS
OPENSEARCH_VERIFY_CERTS=false         # Whether to verify TLS certs (false for local dev clusters)
OPENSEARCH_USERNAME=admin             # Basic auth username for OpenSearch
OPENSEARCH_PASSWORD=admin             # Basic auth password for OpenSearch

# ---- Retrieval ----
TOP_K=3                               # Number of chunks retrieved per question

# ---- Ollama (local LLM) ----
OLLAMA_BASE_URL=http://localhost:11434 # Base URL of the local Ollama REST server
#OLLAMA_MODEL=llama3.1                  # Ollama model tag used for answer generation
#OLLAMA_MODEL=qwen3:4b 
OLLAMA_MODEL=llama3.2:1b                   
OLLAMA_TIMEOUT=180                    # Request timeout (seconds) for Ollama calls

# ---- Logging ----
#LOG_LEVEL=INFO                       # Logging verbosity: DEBUG, INFO, WARNING, ERROR                            
MIN_RELEVANCE_SCORE=0.35              # Minimum relevance score threshold for retrieved chunks